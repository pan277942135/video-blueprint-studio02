{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-blueprint/schema/video_blueprint.schema.json",
  "title": "Video Blueprint Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blueprint_id",
    "created_at",
    "source_video",
    "timebase",
    "processing",
    "shots",
    "characters",
    "camera",
    "environment",
    "quality",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "blueprint_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_video": {
      "$ref": "#/$defs/SourceVideo"
    },
    "timebase": {
      "$ref": "#/$defs/Timebase"
    },
    "processing": {
      "$ref": "#/$defs/Processing"
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shot"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Character"
      }
    },
    "camera": {
      "$ref": "#/$defs/Camera"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Semantics"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "$ref": "#/$defs/BlueprintQuality"
    },
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "TimeSeriesRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "format",
        "dtype",
        "shape",
        "axes",
        "unit",
        "coordinate_space",
        "frame_start",
        "frame_end",
        "checksum_sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "description": "Bundle-relative URI; must not be an arbitrary external URL."
        },
        "format": {
          "type": "string",
          "enum": [
            "npz",
            "npy",
            "parquet",
            "jsonl",
            "png_sequence",
            "rle_json"
          ]
        },
        "dtype": {
          "type": "string",
          "enum": [
            "float16",
            "float32",
            "float64",
            "int16",
            "int32",
            "int64",
            "uint8",
            "bool"
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "string",
          "enum": [
            "none",
            "pixel_xy",
            "normalized_uv",
            "camera_xyz",
            "world_xyz",
            "body_local_2d",
            "body_local_3d"
          ]
        },
        "sampling": {
          "type": "string",
          "enum": [
            "per_frame",
            "per_keyframe",
            "irregular",
            "per_shot"
          ],
          "default": "per_frame"
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        },
        "compression": {
          "type": [
            "string",
            "null"
          ]
        },
        "nan_policy": {
          "type": "string",
          "enum": [
            "preserve",
            "zero_fill",
            "mask_ref"
          ],
          "default": "preserve"
        },
        "interpolation_policy": {
          "type": "string",
          "enum": [
            "none",
            "linear_short_gap",
            "cubic_short_gap",
            "hold"
          ],
          "default": "none"
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Quality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SourceVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "mime_type",
        "container",
        "file_size_bytes",
        "sha256",
        "duration_us",
        "width",
        "height",
        "video_codec",
        "fps_avg",
        "variable_frame_rate",
        "has_audio"
      ],
      "properties": {
        "file_name": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_us": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "display_aspect_ratio": {
          "type": [
            "string",
            "null"
          ]
        },
        "pixel_aspect_ratio": {
          "type": [
            "string",
            "null"
          ]
        },
        "rotation_deg": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "video_codec": {
          "type": "string"
        },
        "pixel_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "bit_depth": {
          "type": [
            "integer",
            "null"
          ]
        },
        "color_primaries": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_transfer": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_space": {
          "type": [
            "string",
            "null"
          ]
        },
        "fps_avg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps_nominal": {
          "type": [
            "number",
            "null"
          ]
        },
        "variable_frame_rate": {
          "type": "boolean"
        },
        "source_frame_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "has_audio": {
          "type": "boolean"
        },
        "audio_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_sample_rate_hz": {
          "type": [
            "integer",
            "null"
          ]
        },
        "audio_channels": {
          "type": [
            "integer",
            "null"
          ]
        },
        "metadata_stripped": {
          "type": "boolean"
        }
      }
    },
    "Timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_to_cfr",
        "fps_num",
        "fps_den",
        "frame_count",
        "frame_duration_us",
        "start_pts_us",
        "end_pts_us"
      ],
      "properties": {
        "normalized_to_cfr": {
          "type": "boolean"
        },
        "fps_num": {
          "type": "integer",
          "minimum": 1
        },
        "fps_den": {
          "type": "integer",
          "minimum": 1
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "frame_duration_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "start_pts_us": {
          "type": "integer"
        },
        "end_pts_us": {
          "type": "integer"
        },
        "source_pts_map_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "status",
        "requested_modules",
        "pipeline_version",
        "config_hash",
        "execution_mode",
        "stages"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "partial"
          ]
        },
        "requested_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pipeline_version": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "offline_local",
            "private_cloud"
          ]
        },
        "hardware": {
          "type": "object",
          "additionalProperties": true
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageStatus"
          }
        }
      }
    },
    "StageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "progress"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "index",
        "frame_start",
        "frame_end",
        "time_start_us",
        "time_end_us",
        "cut_in_type",
        "cut_out_type",
        "transition_score",
        "keyframes",
        "quality"
      ],
      "properties": {
        "shot_id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        },
        "time_start_us": {
          "type": "integer"
        },
        "time_end_us": {
          "type": "integer"
        },
        "cut_in_type": {
          "type": "string",
          "enum": [
            "start",
            "hard_cut",
            "fade",
            "dissolve",
            "unknown"
          ]
        },
        "cut_out_type": {
          "type": "string",
          "enum": [
            "end",
            "hard_cut",
            "fade",
            "dissolve",
            "unknown"
          ]
        },
        "transition_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Keyframe"
          }
        },
        "dominant_character_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "camera_motion_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      }
    },
    "Keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_idx",
        "time_us",
        "kind",
        "score",
        "image_uri"
      ],
      "properties": {
        "frame_idx": {
          "type": "integer",
          "minimum": 0
        },
        "time_us": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "first",
            "middle",
            "last",
            "sharpest",
            "pose_extreme",
            "manual"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "image_uri": {
          "type": "string"
        }
      }
    },
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_id",
        "track_label",
        "presence",
        "bbox_ref",
        "visibility_ref",
        "pose",
        "face",
        "hands",
        "surface_motion",
        "quality",
        "privacy"
      ],
      "properties": {
        "character_id": {
          "type": "string"
        },
        "track_label": {
          "type": "string"
        },
        "presence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameInterval"
          }
        },
        "bbox_ref": {
          "$ref": "#/$defs/TimeSeriesRef"
        },
        "center_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "person_mask_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility_ref": {
          "$ref": "#/$defs/TimeSeriesRef"
        },
        "occlusion_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "appearance_reference_frames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "face": {
          "$ref": "#/$defs/Face"
        },
        "hands": {
          "$ref": "#/$defs/Hands"
        },
        "surface_motion": {
          "$ref": "#/$defs/SurfaceMotion"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "privacy": {
          "$ref": "#/$defs/CharacterPrivacy"
        }
      }
    },
    "FrameInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_start",
        "frame_end"
      ],
      "properties": {
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "skeleton_name",
        "keypoint_count",
        "keypoints_2d_ref",
        "confidence_ref",
        "smoothing",
        "quality"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "skeleton_name": {
          "type": "string"
        },
        "keypoint_count": {
          "type": "integer",
          "minimum": 0
        },
        "keypoint_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keypoints_2d_ref": {
          "$ref": "#/$defs/TimeSeriesRef"
        },
        "keypoints_3d_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_translation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_rotation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "joint_angles_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_ref": {
          "$ref": "#/$defs/TimeSeriesRef"
        },
        "smoothing": {
          "$ref": "#/$defs/Smoothing"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      }
    },
    "Face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "landmark_count",
        "quality"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "landmark_count": {
          "type": "integer",
          "minimum": 0
        },
        "bbox_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "landmarks_3d_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "blendshapes_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_pose_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "gaze_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "eye_openness_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "mouth_open_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "blink_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemporalEvent"
          }
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      }
    },
    "Hands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/HandTrack"
        },
        "right": {
          "$ref": "#/$defs/HandTrack"
        }
      }
    },
    "HandTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "landmark_count",
        "quality"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "landmark_count": {
          "type": "integer",
          "minimum": 0
        },
        "present_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "bbox_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "landmarks_2d_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "landmarks_world_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "handedness_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "palm_normal_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "finger_curl_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        }
      }
    },
    "SurfaceMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "regions",
        "quality"
      ],
      "properties": {
        "coordinate_frame": {
          "type": "string",
          "enum": [
            "body_local_2d",
            "body_local_3d"
          ]
        },
        "body_frame_transform_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "global_postural_sway_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "regions": {
